<UserControl x:Class="TimeTracking.Views.Components.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             mc:Ignorable="d" x:Name="Root">
    <!-- Substitui o DatePicker padrão do WPF (Seção de temas): o DatePicker embutido depende
         internamente de encontrar um Calendar de verdade dentro do seu próprio Popup para ligar
         o botão de abrir o calendário — ao trocar isso pelo componente próprio (SimpleCalendar),
         essa amarração interna quebrava (o popup parava de abrir, e a digitação de data também
         parava de funcionar). Este controle não depende de nada do DatePicker: é só um TextBox
         (parse manual da data) + um botão que abre um Popup com o SimpleCalendar. -->
    <Grid>
        <Border x:Name="FieldBorder" Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="DateTextBox" Grid.Column="0"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         VerticalContentAlignment="Center"
                         Text="{Binding DateText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="DateTextBox_LostFocus"
                         KeyDown="DateTextBox_KeyDown" />

                <Button x:Name="ToggleButton" Grid.Column="1" Focusable="False"
                        Width="26" Height="26" Margin="0,0,3,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="ToggleButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13">
                                <Path Data="{StaticResource CalendarDayIconGeometry}"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Stretch="Uniform" Width="14" Height="14" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=FieldBorder}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,2,0,0">
                <components:SimpleCalendar SelectedDate="{Binding SelectedDate, ElementName=Root, Mode=TwoWay}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
