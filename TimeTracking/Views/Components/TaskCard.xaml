<UserControl x:Class="TimeTracking.Views.Components.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}" Cursor="Hand"
            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
        </Border.InputBindings>
        <!-- Clique direito: mesmo menu Editar/Excluir do botão "...", como atalho adicional.
             Instância própria de ContextMenu — não reaproveita a do botão "..." abaixo, que
             permanece intocada. -->
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource ThemedContextMenuStyle}"
                         DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Editar" Style="{StaticResource ThemedMenuItemStyle}"
                          Command="{Binding SelectTaskCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="Excluir" Style="{StaticResource ThemedMenuItemStyle}"
                          Foreground="{DynamicResource DangerBrush}"
                          Command="{Binding RequestDeleteCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Indicador de seleção (modo de seleção múltipla): puramente visual, o clique
                 no card inteiro (MouseBinding acima) é quem alterna a seleção. -->
            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                <!-- Background/BorderBrush ficam só no Style (nunca como atributo local no
                     Border): um valor local sempre vence um Setter de Style.Triggers no WPF,
                     o que faria o DataTrigger de IsSelected nunca ter efeito visual. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Path Data="M0,3.5 L3,6.5 L8,0.5" Stretch="Uniform" Width="10" Height="10"
                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="14" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <components:TagChip TagItem="{Binding Tag}" Margin="0,8,0,0"
                                     Visibility="{Binding Tag, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding ElapsedDisplay}" FontFamily="Consolas"
                       FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0" />

            <!-- Botão Play: visível apenas quando esta tarefa NÃO está em execução (Seção 11).
                 Volta ao ícone circular original (IconButtonStyle, sem fundo colorido, sem
                 parecer botão) — só maior que o tamanho inicial de 18px. -->
            <Button Grid.Column="3" ToolTip="Iniciar" VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Path Data="{StaticResource PlayIconGeometry}" Fill="{DynamicResource PrimaryBrush}"
                      Stretch="Uniform" Width="24" Height="24" />
            </Button>

            <!-- Stop: visível apenas quando esta é a tarefa em execução (Seção 14). O botão de
                 Pausar foi removido — Stop já cumpre a mesma função mecânica (Seção 34), então
                 manter os dois era redundante. -->
            <Button Grid.Column="3" ToolTip="Parar" VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}" Width="24" Height="24"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Path Data="{StaticResource StopIconGeometry}" Fill="{DynamicResource TextSecondaryBrush}"
                      Stretch="Uniform" Width="24" Height="24" />
            </Button>

            <!-- Menu "..." (Editar/Excluir): substitui os botões de texto fixos fora da área de edição -->
            <Button Grid.Column="4" ToolTip="Mais opções" VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="36"
                    Margin="4,0,0,0"
                    Click="MoreButton_Click"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource ThemedContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Editar" Style="{StaticResource ThemedMenuItemStyle}"
                                  Command="{Binding SelectTaskCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Excluir" Style="{StaticResource ThemedMenuItemStyle}"
                                  Foreground="{DynamicResource DangerBrush}"
                                  Command="{Binding RequestDeleteCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Path Data="{StaticResource MoreIconGeometry}" Fill="{DynamicResource TextSecondaryBrush}"
                      Stretch="Uniform" Width="18" Height="18" />
            </Button>
        </Grid>
    </Border>
</UserControl>
