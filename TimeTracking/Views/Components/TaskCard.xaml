<UserControl x:Class="TimeTracking.Views.Components.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
    </UserControl.Resources>

    <Border Background="#211F1C" BorderBrush="#3A3631" BorderThickness="1" CornerRadius="8"
            Padding="16" Margin="0,0,0,8" Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F2ECE5" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#B8AEA3" Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <components:TagChip TagItem="{Binding Tag}" Margin="0,8,0,0"
                                     Visibility="{Binding Tag, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Excluir" VerticalAlignment="Top"
                    Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent" Foreground="#C87575" BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Border>
</UserControl>
