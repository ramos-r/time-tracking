<UserControl x:Class="TimeTracking.Views.TimeTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeTracking.ViewModels"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TimeTrackingViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:ColorMatchToBorderBrushConverter x:Key="ColorMatchToBorderBrush" />

        <DataTemplate DataType="{x:Type vm:TaskEditorViewModel}">
            <!-- Grid (não StackPanel) porque o popup "Nova tag" (Seção 71) precisa ficar em
                 cima de todo o conteúdo do editor, não só empurrado abaixo dele. -->
            <Grid>
            <StackPanel Margin="24">
                <TextBlock Text="{Binding Title}" FontSize="17" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="Nome" Margin="0,20,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <TextBlock Text="Descrição" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="8"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Tag" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="160" ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" />
                    <Button Content="Limpar" Command="{Binding ClearTagCommand}" Margin="8,0,0,0"
                            Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <!-- Cria uma tag sem sair do editor de tarefa (Seção 71, feedback de
                         usuário) — abre o popup abaixo em vez de obrigar o usuário a ir até a
                         tela Tags. -->
                    <Button Content="Nova tag" Command="{Binding OpenNewTagCommand}" Margin="8,0,0,0"
                            Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>

                <!-- Data/hora (Seção 17): visíveis para tarefa existente com sessão(ões) e
                     também para tarefa nova (permite lançar uma sessão retroativa já na
                     criação); ocultos só para tarefa existente que nunca foi iniciada. -->
                <StackPanel Visibility="{Binding ShowDateFields, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Múltiplas sessões — início da primeira, término da última (somente leitura)"
                               FontSize="11" Foreground="{DynamicResource WarningBrush}" Margin="0,20,0,4" TextWrapping="Wrap"
                               Visibility="{Binding HasMultipleEntries, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Opcional — preencha para registrar uma tarefa que já ocorreu. Deixe em branco para criar sem sessão." FontSize="11"
                               Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,4" TextWrapping="Wrap"
                               Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="Data de início" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <components:DateField Grid.Column="0" SelectedDate="{Binding StartDate}" IsEnabled="{Binding CanEditDates}" />
                        <TextBox Grid.Column="1" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditDates}" Margin="4,0,0,0" ToolTip="HH:mm" />
                    </Grid>

                    <TextBlock Text="Data de término" Margin="0,12,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <components:DateField Grid.Column="0" SelectedDate="{Binding EndDate}" IsEnabled="{Binding CanEditEndDate}" />
                        <TextBox Grid.Column="1" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditEndDate}" Margin="4,0,0,0" ToolTip="HH:mm" />
                    </Grid>
                    <TextBlock Text="Em andamento — pause ou pare o timer para editar o término" FontSize="11"
                               Opacity="0.6" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding DateTimeError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding DateTimeError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                    <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                        <Run Text="Tempo total: " />
                        <Run Text="{Binding TotalElapsedDisplay, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Salvar" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Popup "Nova tag" (Seção 71): mesmo formulário do editor de tag da tela Tags
                 (nome/descrição/cor/salvar/cancelar), só que como um cartão centralizado sobre
                 o próprio editor de tarefa em vez de um painel lateral — o usuário nunca sai
                 daqui para criar a tag. -->
            <Border Background="{DynamicResource OverlayBrush}"
                    Visibility="{Binding IsTagEditorOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="24" MaxWidth="312" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel DataContext="{Binding TagEditor}">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock Text="Nome" Margin="0,20,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                        <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding NameError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <TextBlock Text="Descrição" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="Cor" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="0,0,8,8" Background="{Binding}"
                                            BorderThickness="2" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.BorderBrush>
                                            <MultiBinding Converter="{StaticResource ColorMatchToBorderBrush}">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </Button.BorderBrush>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"
                                 FontFamily="Consolas" MaxLength="7" />
                        <TextBlock Text="{Binding ColorError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding ColorError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,16,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Salvar" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Layout raiz: coluna do conteúdo (header+lista) + coluna do painel de edição, que
         empurra o conteúdo ao abrir (largura anima 0↔360) em vez de deslizar por cima com uma
         camada escurecida atrás (Seção 71, feedback de usuário). Os diálogos de confirmação
         (exclusão, conflito de timer) continuam como overlay escurecido de verdade — são
         modais bloqueantes, não navegação — por isso cobrem as duas colunas
         (Grid.ColumnSpan="2") em vez de ganhar uma coluna própria. -->
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo: cada tema tem seu próprio PNG (LogoImageSource é redefinido em
                 Dark.xaml/Light.xaml, troca sozinho junto com o tema). BitmapScalingMode
                 HighQuality evita serrilhado no downscale (imagem-fonte é bem maior que o
                 tamanho exibido) — complementa o DecodePixelHeight já aplicado no recurso. -->
            <Image Grid.Column="0" Source="{DynamicResource LogoImageSource}" Height="36"
                   Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVisibility}}">
                <Button Command="{Binding StartQuickTaskCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PlayAltIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock Text="Iniciar timer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenNewTaskCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SquarePlusIconGeometry}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock Text="Nova tarefa" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Modo de seleção múltipla (exclusão em lote) — entrado via clique direito no
                 cabeçalho de um grupo de data ("Selecionar", Seção 68). Só revela as caixinhas,
                 sem marcar nada sozinho; "Selecionar todas" marca as tarefas do grupo escolhido
                 por último, nunca de todos os dias de uma vez. O menu "..."/clique direito
                 individual das tarefas continuam funcionando normalmente em qualquer modo. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SelectedCountDisplay}" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Command="{Binding SelectAllInActiveGroupCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                    <TextBlock Text="Selecionar todas" />
                </Button>
                <Button Command="{Binding DeselectAllCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                    <TextBlock Text="Desmarcar todas" />
                </Button>
                <Button Command="{Binding CancelSelectionModeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                    <TextBlock Text="Cancelar" />
                </Button>
                <Button Command="{Binding RequestBulkDeleteCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Style="{StaticResource DangerButtonStyle}">
                    <TextBlock Text="Excluir selecionadas" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock Text="{Binding ListErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"
                           Visibility="{Binding ListErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <ItemsControl ItemsSource="{Binding DayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:DayGroupSection />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Clique fora do painel de edição fecha ele (Seção 20) — sem escurecer (Seção 71),
             só um Border transparente que existe apenas enquanto o editor está aberto. Ficou
             faltando quando o overlay escurecido foi removido para o painel "empurrar" o
             conteúdo em vez de sobrepor (Seção 71, feedback de usuário: o clique fora parou de
             fechar o painel). -->
        <Border Grid.Column="0" Background="Transparent"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditorCommand}" />
            </Border.InputBindings>
        </Border>

        <!-- Painel direito de edição/criação (Seção 20): agora uma coluna própria que anima a
             largura (0↔360) para empurrar o conteúdo à esquerda, sem camada escurecida atrás
             (Seção 71, feedback de usuário) — fecha pelos botões Cancelar/Salvar ou clicando
             fora dele (Border acima). O Border interno de largura fixa evita que o formulário
             reflua/aperte enquanto a largura do host ainda está animando. -->
        <Border Grid.Column="1" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="360" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="360">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Editor}" />
                </ScrollViewer>
            </Border>
        </Border>

        <!-- Confirmação de exclusão (Seção 23, componente da Seção 30) — diálogo modal de
             verdade (bloqueia a tela toda, Grid.ColumnSpan cobre conteúdo + coluna do editor),
             diferente do painel de edição acima. -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Excluir tarefa?"
                                       Message="{Binding DeleteConfirmMessage}"
                                       ConfirmText="Excluir" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmDeleteCommand}"
                                       CancelCommand="{Binding CancelDeleteCommand}" />
        </Border>

        <!-- Confirmação de exclusão em lote (seleção múltipla) — diálogo próprio, não
             interfere com a confirmação de exclusão individual acima. -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBulkDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Excluir tarefas selecionadas?"
                                       Message="{Binding BulkDeleteConfirmMessage}"
                                       ConfirmText="Excluir" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmBulkDeleteCommand}"
                                       CancelCommand="{Binding CancelBulkDeleteCommand}" />
        </Border>

        <!-- Conflito de timer: só uma tarefa ativa por vez (Seção 15) — não é destrutivo -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsPlayConflictOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Tarefa em execução"
                                       Message="{Binding PlayConflictMessage}"
                                       ConfirmText="Iniciar" CancelText="Cancelar"
                                       IsDestructive="False"
                                       ConfirmCommand="{Binding ConfirmPlayConflictCommand}"
                                       CancelCommand="{Binding CancelPlayConflictCommand}" />
        </Border>
    </Grid>
</UserControl>
