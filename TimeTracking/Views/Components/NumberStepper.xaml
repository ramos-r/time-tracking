<UserControl x:Class="TimeTracking.Views.Components.NumberStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TimeTracking.Views.Components"
             mc:Ignorable="d"
             x:Name="Root">
    <!-- Campo numérico compacto com botões − e + (segurar o botão repete) — para o usuário não
         depender só de digitar. O texto continua passando pela validação do ViewModel. -->
    <UserControl.Resources>
        <Style x:Key="StepButtonStyle" TargetType="RepeatButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="90" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover neutro (cinza do tema), sem a cor de destaque. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <RepeatButton x:Name="DecrementButton" Style="{StaticResource StepButtonStyle}" Click="Decrement_Click"
                      ToolTip="Diminuir" AutomationProperties.Name="Diminuir">
            <Path Data="M 0,0 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="None" Margin="0,1,0,0" />
        </RepeatButton>
        <TextBox x:Name="ValueBox" Width="32" Height="22" Margin="4,0" Padding="0,1" FontSize="12"
                 TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="3"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=LostFocus}"
                 KeyDown="ValueBox_KeyDown" />
        <RepeatButton x:Name="IncrementButton" Style="{StaticResource StepButtonStyle}" Click="Increment_Click"
                      ToolTip="Aumentar" AutomationProperties.Name="Aumentar">
            <Path Data="M 0,4 L 8,4 M 4,0 L 4,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="None" />
        </RepeatButton>
    </StackPanel>
</UserControl>
