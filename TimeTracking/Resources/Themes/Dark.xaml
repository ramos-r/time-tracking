<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta Dark Mode (Seção 28) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#181614" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#211F1C" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#292622" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3631" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#C89B6D" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#D8AE82" />
