<Window x:Class="TimeTracking.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeTracking.ViewModels"
        xmlns:views="clr-namespace:TimeTracking.Views"
        xmlns:components="clr-namespace:TimeTracking.Views.Components"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Time Tracking"
        Icon="/Resources/Icons/AppIcon.ico"
        Height="600" Width="960"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:TimeTrackingViewModel}">
            <views:TimeTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagsViewModel}">
            <views:TagsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <views:PomodoroView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra superior: sempre visível, contém o botão hamburger (Seção 19) -->
        <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSidebarCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        Width="48" Height="48">
                    <Path Data="{StaticResource HamburgerIconGeometry}" Fill="{DynamicResource TextPrimaryBrush}"
                          Stretch="Uniform" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding PageTitle}" FontSize="15" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding ShowPageTitle, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Área de conteúdo + sidebar: agora empurra o conteúdo (largura anima 0↔240) em vez
             de deslizar por cima com uma camada escurecida atrás (Seção 71, feedback de
             usuário) — a Sidebar em si mantém sua largura interna fixa de 240 (Sidebar.xaml);
             quem anima é este Border externo, que a recorta (ClipToBounds) enquanto cresce,
             revelando o conteúdo progressivamente em vez de traduzi-la como um bloco. -->
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="240" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <components:Sidebar DataContext="{Binding}" />
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </DockPanel>
</Window>
