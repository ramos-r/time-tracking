<UserControl x:Class="TimeTracking.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeTracking.ViewModels"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:ColorMatchToBorderBrushConverter x:Key="ColorMatchToBorderBrush" />

        <DataTemplate DataType="{x:Type vm:TagEditorViewModel}">
            <StackPanel Margin="24">
                <TextBlock Text="{Binding Title}" FontSize="17" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Text="Nome" Margin="0,20,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <TextBlock Text="Descrição" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" Padding="8"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Cor" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <ItemsControl ItemsSource="{Binding PaletteColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="28" Height="28" Margin="0,0,8,8" Background="{Binding}"
                                    BorderThickness="2" Cursor="Hand"
                                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ColorMatchToBorderBrush}">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </Button.BorderBrush>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}"
                                                 Stroke="{TemplateBinding BorderBrush}"
                                                 StrokeThickness="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Dot" Property="Opacity" Value="0.8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"
                         FontFamily="Consolas" MaxLength="7" />
                <TextBlock Text="{Binding ColorError}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding ColorError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Salvar" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tags" FontSize="22" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}" Margin="24,24,24,8" />

        <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock Text="{Binding ListErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"
                           Visibility="{Binding ListErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="20,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Menu "..." (Editar/Excluir): substitui os botões de texto fixos, igual ao card de tarefa -->
                                    <Button Grid.Column="1" ToolTip="Mais opções" VerticalAlignment="Center"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="36" Height="36"
                                            Click="MoreButton_Click"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource ThemedContextMenuStyle}"
                                                         DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Editar" Style="{StaticResource ThemedMenuItemStyle}"
                                                          Command="{Binding SelectTagCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Excluir" Style="{StaticResource ThemedMenuItemStyle}"
                                                          Foreground="{DynamicResource DangerBrush}"
                                                          Command="{Binding RequestDeleteCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Path Data="{StaticResource MoreIconGeometry}" Fill="{DynamicResource TextSecondaryBrush}"
                                              Stretch="Uniform" Width="18" Height="18" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Nova tag" Command="{Binding OpenNewTagCommand}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Painel de criação/edição de tag -->
        <Border Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditorCommand}" />
            </Border.InputBindings>
        </Border>

        <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="360" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform X="360" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="360" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl Content="{Binding Editor}" />
        </Border>

        <!-- Confirmação de exclusão (Seção 30) -->
        <Border Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Excluir tag?"
                                       Message="{Binding DeleteConfirmMessage}"
                                       ConfirmText="Excluir" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmDeleteCommand}"
                                       CancelCommand="{Binding CancelDeleteCommand}" />
        </Border>
    </Grid>
</UserControl>
