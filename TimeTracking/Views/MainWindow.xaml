<Window x:Class="TimeTracking.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeTracking.ViewModels"
        xmlns:views="clr-namespace:TimeTracking.Views"
        xmlns:components="clr-namespace:TimeTracking.Views.Components"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Time Tracking"
        Icon="/Resources/Icons/AppIcon.ico"
        Height="600" Width="960"
        MinHeight="480" MinWidth="720"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:TimeTrackingViewModel}">
            <views:TimeTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagsViewModel}">
            <views:TagsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroViewModel}">
            <views:PomodoroView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra superior: sempre visível, contém o botão hamburger (Seção 19) -->
        <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            Width="48" Height="48">
                        <Path Data="{StaticResource HamburgerIconGeometry}" Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform" Width="18" Height="18" />
                    </Button>
                    <TextBlock Text="{Binding PageTitle}" FontSize="15" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding ShowPageTitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Chip do Pomodoro em andamento (D9): discreto, só fora da tela Pomodoro; o
                     clique leva até ela. O ponto colorido acompanha a fase (foco = cor de
                     destaque, pausa = sucesso), mas o texto também diz qual é (Seção 41). -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        DataContext="{Binding Pomodoro}"
                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:AppPage.Pomodoro}"
                        ToolTip="Pomodoro em andamento — clique para abrir"
                        Cursor="Hand" Focusable="True"
                        Visibility="{Binding DataContext.ShowPomodoroChip, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocusPhase}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBreakPhase}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ChipText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Área de conteúdo + sidebar: agora empurra o conteúdo (largura anima 0↔240) em vez
             de deslizar por cima com uma camada escurecida atrás (Seção 71, feedback de
             usuário) — a Sidebar em si mantém sua largura interna fixa de 240 (Sidebar.xaml);
             quem anima é este Border externo, que a recorta (ClipToBounds) enquanto cresce,
             revelando o conteúdo progressivamente em vez de traduzi-la como um bloco. -->
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="240" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <components:Sidebar DataContext="{Binding}" />
            </Border>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentViewModel}" />

                <!-- Clique fora do menu fecha ele (Seção 19) — sem escurecer (Seção 71), só
                     um Border transparente que existe apenas enquanto o menu está aberto. Ficou
                     faltando quando o overlay escurecido foi removido para o menu "empurrar" o
                     conteúdo em vez de sobrepor (Seção 71, feedback de usuário: o clique fora
                     parou de fechar o menu). -->
                <Border Background="Transparent"
                        Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSidebarCommand}" />
                    </Border.InputBindings>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
