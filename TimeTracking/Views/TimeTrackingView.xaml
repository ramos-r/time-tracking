<UserControl x:Class="TimeTracking.Views.TimeTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeTracking.ViewModels"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TimeTrackingViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

        <DataTemplate DataType="{x:Type vm:TaskEditorViewModel}">
            <StackPanel Margin="24">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#F2ECE5" />

                <TextBlock Text="Nome" Margin="0,20,0,4" Opacity="0.7" FontSize="12" Foreground="#F2ECE5" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" />
                <TextBlock Text="{Binding NameError}" Foreground="#C87575" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <TextBlock Text="Descrição" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="#F2ECE5" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" Padding="8"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Tag" Margin="0,16,0,4" Opacity="0.7" FontSize="12" Foreground="#F2ECE5" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="220" ItemsSource="{Binding AvailableTags}"
                              SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" />
                    <Button Content="Limpar" Command="{Binding ClearTagCommand}" Margin="8,0,0,0" Padding="8,4" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C87575" FontSize="12" Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Padding="16,8" Margin="0,0,8,0"
                            Background="Transparent" Foreground="#F2ECE5" BorderBrush="#3A3631" BorderThickness="1" />
                    <Button Content="Salvar" Command="{Binding SaveCommand}" Padding="16,8"
                            Background="#C89B6D" Foreground="#181614" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hoje" FontSize="14" Opacity="0.6" Foreground="#F2ECE5" Margin="24,24,24,8" />

        <ScrollViewer Grid.Row="1" Margin="24,0,24,24">
            <StackPanel>
                <TextBlock Text="{Binding ListErrorMessage}" Foreground="#C87575" Margin="0,0,0,12"
                           Visibility="{Binding ListErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:TaskCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Nova tarefa" Command="{Binding OpenNewTaskCommand}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="16,8"
                        Background="#C89B6D" Foreground="#181614" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </ScrollViewer>

        <!-- Painel direito de edição/criação (Seção 20) -->
        <Border Grid.RowSpan="2" Background="#B3000000"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditorCommand}" />
            </Border.InputBindings>
        </Border>

        <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="360" Background="#211F1C"
                BorderBrush="#3A3631" BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <ContentControl Content="{Binding Editor}" />
        </Border>

        <!-- Confirmação de exclusão (Seção 23, componente da Seção 30) -->
        <Border Grid.RowSpan="2" Background="#B3000000"
                Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Excluir tarefa?"
                                       Message="{Binding DeleteConfirmMessage}"
                                       ConfirmText="Excluir" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmDeleteCommand}"
                                       CancelCommand="{Binding CancelDeleteCommand}" />
        </Border>

        <!-- Conflito de timer: só uma tarefa ativa por vez (Seção 15) -->
        <Border Grid.RowSpan="2" Background="#B3000000"
                Visibility="{Binding IsPlayConflictOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Tarefa em execução"
                                       Message="{Binding PlayConflictMessage}"
                                       ConfirmText="Iniciar" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmPlayConflictCommand}"
                                       CancelCommand="{Binding CancelPlayConflictCommand}" />
        </Border>
    </Grid>
</UserControl>
