<UserControl x:Class="TimeTracking.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TimeTracking.ViewModels"
             xmlns:svc="clr-namespace:TimeTracking.Services"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <converters:EnumToBooleanConverter x:Key="EnumToBoolean" />
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <ScrollViewer Margin="24" VerticalScrollBarVisibility="Hidden">
            <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="Settings" FontSize="22" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24" />

                <!-- Aparência -->
                <TextBlock Text="Aparência" FontSize="15" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Tema" FontSize="12" Opacity="0.7"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel>
                    <RadioButton Content="Dark" GroupName="Theme" Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static svc:AppTheme.Dark}}" />
                    <RadioButton Content="Light" GroupName="Theme" Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static svc:AppTheme.Light}}" />
                    <RadioButton Content="Sistema" GroupName="Theme" Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static svc:AppTheme.System}}" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,24" />

                <!-- Dados -->
                <TextBlock Text="Dados" FontSize="15" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <Button Content="Limpar histórico" Command="{Binding RequestClearHistoryCommand}"
                        HorizontalAlignment="Left" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="16,8" />
                            <Setter Property="FontFamily" Value="{StaticResource AppFontFamilyLight}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,24" />

                <!-- Sobre -->
                <TextBlock Text="Sobre" FontSize="15" FontFamily="{StaticResource AppFontFamilyLight}" FontWeight="Normal"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock Text="Time Tracking" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Versão " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirmação de limpar histórico (Seção 27) -->
        <Border Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsClearHistoryConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <components:ConfirmDialog Title="Excluir histórico?"
                                       Message="Esta ação removerá todas as tarefas e registros de tempo. As tags cadastradas serão preservadas.&#10;&#10;Essa ação não pode ser desfeita."
                                       ConfirmText="Excluir" CancelText="Cancelar"
                                       ConfirmCommand="{Binding ConfirmClearHistoryCommand}"
                                       CancelCommand="{Binding CancelClearHistoryCommand}" />
        </Border>
    </Grid>
</UserControl>
