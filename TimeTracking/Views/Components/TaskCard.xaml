<UserControl x:Class="TimeTracking.Views.Components.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:TimeTracking.Views.Components"
             xmlns:converters="clr-namespace:TimeTracking.Converters"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="16" Margin="0,0,0,8" Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick"
                          Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <components:TagChip TagItem="{Binding Tag}" Margin="0,8,0,0"
                                     Visibility="{Binding Tag, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ElapsedDisplay}" FontFamily="Consolas"
                       FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0" />

            <!-- Botão Play: visível apenas quando esta tarefa NÃO está em execução (Seção 11) -->
            <Button Grid.Column="2" Content="&#9654;" ToolTip="Iniciar" VerticalAlignment="Center"
                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Width="36" Height="36" FontSize="14"
                    Background="Transparent" Foreground="{DynamicResource SuccessBrush}" BorderThickness="0" Cursor="Hand" />

            <!-- Pause/Stop: visíveis apenas quando esta é a tarefa em execução (Seção 12/14) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#9208;" ToolTip="Pausar" VerticalAlignment="Center"
                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Width="36" Height="36" FontSize="14"
                        Background="Transparent" Foreground="{DynamicResource WarningBrush}" BorderThickness="0" Cursor="Hand" />
                <Button Content="&#9632;" ToolTip="Parar" VerticalAlignment="Center"
                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Width="36" Height="36" FontSize="14"
                        Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand" />
            </StackPanel>

            <Button Grid.Column="3" Content="Excluir" VerticalAlignment="Center"
                    Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"
                    Margin="8,0,0,0" />
        </Grid>
    </Border>
</UserControl>
