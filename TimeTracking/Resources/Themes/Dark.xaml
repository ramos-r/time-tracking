<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta Dark Mode (Seção 28) — cinza neutro (R=G=B), não mais com viés quente
         (quando R>G>B) da paleta original. Background e SurfaceElevated batem exatamente
         com a referência passada pelo usuário (#181818 / #2F2F2F); os demais tons preservam
         a mesma hierarquia relativa de antes, só neutralizados. -->
    <!-- BackgroundBrush é um gradiente (não SolidColorBrush) para o efeito de luz subindo de
         baixo para cima pedido pelo usuário — todo lugar que usa {DynamicResource
         BackgroundBrush} continua funcionando igual, já que só o tipo concreto do Brush
         mudou, não a chave. Radial (não linear) e ancorado no centro-inferior para o brilho
         parecer uma fonte de luz curva, não uma faixa reta ponta a ponta. -->
    <RadialGradientBrush x:Key="BackgroundBrush" Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.75" RadiusY="0.65">
        <GradientStop Color="#242424" Offset="0" />
        <GradientStop Color="#202020" Offset="0.2" />
        <GradientStop Color="#1E1E1E" Offset="0.4" />
        <GradientStop Color="#1B1B1B" Offset="0.6" />
        <GradientStop Color="#191919" Offset="0.8" />
        <GradientStop Color="#181818" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D" />
    <!-- PrimaryBrush/PrimaryHoverBrush/PrimaryPressedBrush/PrimarySubtleBrush/TextOnPrimaryBrush
         deixaram de ser fixos aqui (Seção 28, nota v1.4) — agora são calculados em runtime pelo
         AccentColorService (Seção 69) a partir da cor de destaque escolhida pelo usuário, e
         publicados via DynamicResource em um dicionário próprio (ver AccentColorService.Publish). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ACACAC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FAE82" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D3A85C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C87575" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />

    <!-- Logo por tema: cada tema referencia seu próprio PNG (mesmo mecanismo de troca via
         DynamicResource do restante desta paleta) — ver Views/TimeTrackingView.xaml.
         DecodePixelHeight decodifica o PNG (2399x508 original) já num tamanho próximo do
         exibido (Height=36 na View, com folga para telas HiDPI) — sem isso, o WPF decodifica
         no tamanho original e escala em tempo de render, o que produz serrilhado visível
         num downscale desse tamanho (~14x). -->
    <BitmapImage x:Key="LogoImageSource" UriSource="pack://application:,,,/Resources/Images/Logo-Tema-Escuro.png"
                 DecodePixelHeight="120" />
</ResourceDictionary>
